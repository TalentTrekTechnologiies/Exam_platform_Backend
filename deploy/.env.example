# ─────────────────────────────────────────────────────────────────────────────
#  Copy to `.env` and fill in. Never commit the real .env.
#
#  Nothing here costs money — the server itself is the only expense, and Oracle
#  Cloud "Always Free" covers even that. See HOSTINGER.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required: the stack will not start safely without these two ──────────────

# At least 32 characters. Anyone holding this can mint admin tokens for every
# institution on the server — generate a fresh random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# MySQL root password for the compose database.
DB_PASSWORD=change-me

# ── Schema ───────────────────────────────────────────────────────────────────
# `update` for the very first boot against an empty database (creates tables),
# then switch to `validate` and restart so the schema can't be reshaped silently.
DDL_AUTO=update

# ── Where the app is reached ─────────────────────────────────────────────────
# Frontend origin(s) allowed to call the API, comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost

# Public URL candidates open the exam on — used to build the shareable link.
CANDIDATE_BASE_URL=https://exams.ksrm.edu.in

# ── Deployment mode ──────────────────────────────────────────────────────────
# false = a dedicated install (KSRM's own module): no college self-registration.
# true  = the shared platform where colleges sign themselves up.
ALLOW_REGISTRATION=false

# ── First admin (dedicated install) ──────────────────────────────────────────
# With registration off, this is the ONLY way in. SEED_ADMIN_CODE must equal the
# frontend's VITE_INSTITUTION_CODE, or every candidate sign-in is refused as an
# invalid link. Leave the password blank to skip seeding and register manually.
SEED_ADMIN_EMAIL=exams@ksrm.edu.in
SEED_ADMIN_PASSWORD=
SEED_ADMIN_COLLEGE=KSRM College of Engineering
SEED_ADMIN_CODE=ksrm-college

# ── Email (optional — free) ──────────────────────────────────────────────────
# Leave MAIL_ENABLED=false to build and rehearse without sending: hall-ticket and
# exam-link mail still queues to the outbox, it just doesn't go out. Fill in when
# ready. Every option below has a free tier.
#
#   Google Workspace:  SMTP_HOST=smtp.gmail.com         SMTP_PORT=587
#   Microsoft 365:     SMTP_HOST=smtp.office365.com      SMTP_PORT=587
#   Brevo (free tier): SMTP_HOST=smtp-relay.brevo.com    SMTP_PORT=587
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=exams@ksrm.edu.in
MAIL_FROM_NAME=KSRM Examinations

# ── Capacity tuning ──────────────────────────────────────────────────────────
# Per-instance connection pool. Keep (instance_count x DB_POOL_SIZE) below the
# database's max_connections (300 in mysql-tuning.cnf). 3 x 50 = 150.
DB_POOL_SIZE=50
